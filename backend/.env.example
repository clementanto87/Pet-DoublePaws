# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=petdaycare

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Transactional email (Resend)
# Keep RESEND_API_KEY only on the backend/Railway service.
RESEND_API_KEY=
EMAIL_FROM=Double Paws <notifications@your-domain.com>
EMAIL_REPLY_TO=
EMAIL_APP_URL=http://localhost:5173
