# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=petdaycare

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Transactional email (Resend)
# Keep RESEND_API_KEY only on the backend/Railway service.
RESEND_API_KEY=
EMAIL_FROM=Double Paws <notifications@your-domain.com>
EMAIL_REPLY_TO=
EMAIL_APP_URL=https://doublepaws24.com
# Optional public HTTPS logo URL; defaults to EMAIL_APP_URL/logo.jpg.
# Use a public URL so links and images work in recipients’ email clients.
EMAIL_LOGO_URL=https://doublepaws24.com/logo.jpg

# Stripe Payments & Connect
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=eur
PLATFORM_FEE_PERCENT=10
